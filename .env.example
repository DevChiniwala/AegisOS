# ═══════════════════════════════════════════════════════════════════════════════
# AegisOS Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core ────────────────────────────────────────────────────────────────────
AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_SECURITY_SECRET_KEY=your-secret-key-change-in-production

# ─── Database ────────────────────────────────────────────────────────────────
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis_secret@localhost:5432/aegisdb
AEGIS_REDIS_URL=redis://localhost:6379/0

# ─── Graph Database ──────────────────────────────────────────────────────────
AEGIS_NEO4J_URI=bolt://localhost:7687
AEGIS_NEO4J_USER=neo4j
AEGIS_NEO4J_PASSWORD=aegis_neo4j

# ─── Vector Store ────────────────────────────────────────────────────────────
AEGIS_QDRANT_URL=http://localhost:6333

# ─── LLM Providers (BYOK — Bring Your Own Key) ──────────────────────────────
# At least one is required for agent reasoning. Falls back to heuristics if none set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegisos-api

# ─── Object Storage ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aegis_minio
MINIO_SECRET_KEY=aegis_minio_secret

# ─── Dashboard ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=AegisOS
